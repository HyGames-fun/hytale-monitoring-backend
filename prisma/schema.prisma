generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id Int @id @default(autoincrement())

  name     String
  email    String? @unique
  avatar   String?
  password String?

  discordId String? @unique @map("discord_id")

  servers      Server[]
  likedServers Server[] @relation("user_liked_servers")

  @@map("user")
}

model Server {
  id          Int     @id @default(autoincrement())
  domain      String  @unique
  ip          String? @unique @map("real_ip")
  description String
  name        String
  nameId      String  @unique @map("name_id")
  tags        Tag[]
  region      Region
  poster      String?
  likes       Int     @default(0)

  userId Int?  @map("user_id")
  user   User? @relation(fields: [userId], references: [id])

  likedUsers User[] @relation("user_liked_servers")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt() @map("updated_at")

  @@map("server")
}

enum Region {
  CIS
  EUROPE
  ASIA
  AFRICA
  NORTHAMERICA
  SOUTHAMERICA
}

enum Tag {
  PVP
  PVE
  RP
  RPG
  VANILLA
  SURVIVAL
  MINIGAMES
}
